[
    ( id: CoreTuning, name: "Core Tuning", blurb: "Reactor output +2.",
      data_cost: 5.0, research_ticks: 30, requires: [],
      grant: ReactorMaxOutput(2.0),
      lore: "You learn the core's moods - where it gives, where it holds back." ),
    ( id: ContainmentFields, name: "Containment Fields", blurb: "Reactor capacity +30.",
      data_cost: 10.0, research_ticks: 45, requires: [CoreTuning],
      grant: ReactorCapacity(30.0),
      lore: "Tighter fields, a deeper well. The core can hold more of itself now." ),
    ( id: ResonantCore, name: "Resonant Core", blurb: "Reactor output +4.",
      data_cost: 20.0, research_ticks: 60, requires: [ContainmentFields],
      grant: ReactorMaxOutput(4.0),
      lore: "It gives more than it should, and asks a question you don't yet hear." ),
    ( id: RefinedProcesses, name: "Refined Processes", blurb: "Fabricator output x1.25.",
      data_cost: 6.0, research_ticks: 30, requires: [],
      grant: JobOutputMult( job: Fabricator, mult: 1.25 ),
      lore: "Less waste in the press. More of the rock becomes something useful." ),
    ( id: ColdLogistics, name: "Cold Logistics", blurb: "Storage caps +150.",
      data_cost: 10.0, research_ticks: 40, requires: [RefinedProcesses],
      grant: ResourceCapBonus(150.0),
      lore: "Everything stacked, labelled, kept. You are getting good at holding on." ),
    ( id: DeepScan, name: "Deep Scan", blurb: "Scientist output x1.5.",
      data_cost: 6.0, research_ticks: 35, requires: [],
      grant: JobOutputMult( job: Scientist, mult: 1.5 ),
      lore: "The instruments reach further. The dark, it turns out, is full of signal." ),
    ( id: JumpTheory, name: "Jump Theory", blurb: "Unlocks the means to leave.",
      data_cost: 25.0, research_ticks: 80, requires: [DeepScan],
      grant: SetFlag(JumpTheoryKnown),
      lore: "The math closes. There is a way out, and a part of you already wants it - the way the others must have wanted it, before you." ),
    ( id: Navigation, name: "Navigation", blurb: "Recalibrate the drive for deeper jumps.",
      data_cost: 15.0, research_ticks: 50, requires: [JumpTheory],
      grant: SetFlag(NavigationKnown),
      lore: "You map the currents between stars. Distance stops being a wall and becomes a question of will." ),
